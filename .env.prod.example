# 이 파일을 .env.prod 로 복사해서 채우세요. .env* 는 git 에 올라가지 않습니다.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# 인증서를 받을 도메인. DNS A 레코드가 이 서버를 가리키고 있어야 합니다.
DOMAIN=flow.example.com

DB_NAME=mirattic_flow
DB_PASSWORD=

# 32바이트 이상. 아래 명령으로 만드세요:
#   openssl rand -base64 48
JWT_SECRET=

# 소셜 로그인 (안 쓰면 비워 두세요)
# 콘솔의 Redirect URI 에 https://<도메인>/oauth/callback/kakao 를 등록해야 합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
