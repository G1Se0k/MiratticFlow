# 이 파일을 배포 호스트의 .env.prod 로 복사해서 채우세요. .env* 는 git 에 올라가지 않습니다.
# 배포는 CI 가 합니다 (.github/workflows/deploy.yml → deploy.sh). docker-compose.prod.yml 이 읽는 값은 아래가 전부입니다.

# 서비스 도메인: CORS 허용 origin 이 https://<DOMAIN>. 프런트의 API 주소(deploy.yml 의 빌드 인자)와 Auth redirect
# (application-prod.properties)는 flow.mirattic.com 으로 고정이라, 다른 도메인이면 그 둘도 바꿔야 합니다.
DOMAIN=flow.example.com

DB_NAME=mirattic_flow
DB_PASSWORD=

# Mirattic Auth client `mirattic-flow` 의 원본 secret (Auth 호스트의 client-secrets.txt). 반드시 채우세요: 기본값이 없고,
# 변수가 없으면 기동에 실패하며, 빈 값이면 기동은 되지만 로그인이 되지 않습니다.
# 카카오 · 네이버 · Google 로그인은 Mirattic Auth 가 처리하므로 Flow 에는 소셜 로그인 키가 없습니다.
AUTH_CLIENT_SECRET=
